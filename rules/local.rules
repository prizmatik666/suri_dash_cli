alert ssh !$HOME_NET any -> $HOME_NET 22 (msg:"LOCAL SSH inbound connection to server"; flow:to_server,established; sid:1001001; rev:1;)
alert ssh !$HOME_NET any -> $HOME_NET 22 (msg:"LOCAL SSH possible brute force - repeated inbound connections"; flow:to_server,established; detection_filter:track by_src,count 5,seconds 60; sid:1001002; rev:1;)
alert ssh $HOME_NET any -> !$HOME_NET 22 (msg:"LOCAL SSH outbound connection from internal host"; flow:to_server,established; sid:1001003; rev:1;)

# Local IDS reconnaissance indicators. These are SYN packet-rate heuristics;
# they do not count unique destination hosts or unique destination ports.
# threshold:type both intentionally limits duplicate alerts after each threshold;
# SIDs 1001101-1001103 are locally reserved. Added 2026-09-17.
alert tcp $HOME_NET any -> $HOME_NET any (msg:"LOCAL SCAN Possible TCP SYN burst to internal host"; tcp.flags:S,CE; threshold: type both, track by_both, count 10, seconds 10; classtype:attempted-recon; priority:2; sid:1001101; rev:3;)
alert tcp $HOME_NET any -> $HOME_NET any (msg:"LOCAL SCAN Possible broad TCP SYN burst from internal host"; tcp.flags:S,CE; threshold: type both, track by_src, count 25, seconds 10; classtype:attempted-recon; priority:2; sid:1001102; rev:2;)
alert tcp $EXTERNAL_NET any -> $HOME_NET any (msg:"EXTERNAL SCAN Possible inbound TCP SYN burst"; tcp.flags:S,CE; threshold: type both, track by_src, count 10, seconds 10; classtype:attempted-recon; priority:2; sid:1001103; rev:2;)
